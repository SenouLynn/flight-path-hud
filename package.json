{
  "name": "flight-path-hud",
  "private": true,
  "workspaces": [
    "apps/hud",
    "apps/gcs",
    "apps/mavlink-bridge",
    "apps/video-bridge",
    "packages/gcs-core",
    "packages/hud-ui"
  ],
  "scripts": {
    "gcs:mock": "npm run dev --workspace @flight-path-hud/gcs & npm run start --workspace @flight-path-hud/mavlink-bridge & npm run sample:udp --workspace @flight-path-hud/mavlink-bridge & npm run mock --workspace @flight-path-hud/video-bridge",
    "gcs:sitl-test": "docker compose -f apps/mavlink-bridge/sitl/compose.yml up --build --detach && npm run dev --workspace @flight-path-hud/gcs",
    "sitl-test:motion": "docker compose -f apps/mavlink-bridge/sitl/compose.yml -f apps/mavlink-bridge/sitl/compose.motion.yml up --build --abort-on-container-exit --exit-code-from motion-controller",
    "sitl-test:motion:down": "docker compose -f apps/mavlink-bridge/sitl/compose.yml -f apps/mavlink-bridge/sitl/compose.motion.yml down",
    "dev:hud": "npm run dev --workspace @flight-path-hud/hud",
    "build:hud": "npm run build --workspace @flight-path-hud/hud",
    "lint:hud": "npm run lint --workspace @flight-path-hud/hud",
    "test:hud": "npm run test --workspace @flight-path-hud/hud",
    "build:gcs": "npm run build --workspace @flight-path-hud/gcs",
    "test:gcs-core": "npm run test --workspace @flight-path-hud/gcs-core",
    "test:bridge": "npm run test --workspace @flight-path-hud/mavlink-bridge",
    "replay:bridge": "npm run replay --workspace @flight-path-hud/mavlink-bridge",
    "test:esp32": "make -C apps/esp32 test",
    "preview:esp32": "make -C apps/esp32 run",
    "test:hud-ui": "npm run test --workspace @flight-path-hud/hud-ui",
    "clean:recordings": "MAVLINK_BRIDGE_RECORD_DIR=apps/mavlink-bridge/recordings node apps/mavlink-bridge/src/cleanRecordings.js",
    "test:gcs": "npm run test --workspace @flight-path-hud/gcs",
    "sitl-test:up": "docker compose -f apps/mavlink-bridge/sitl/compose.yml up --build",
    "sitl-test:down": "docker compose -f apps/mavlink-bridge/sitl/compose.yml down",
    "sitl-test:logs": "docker compose -f apps/mavlink-bridge/sitl/compose.yml logs --follow"
  }
}
