{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flight-path-hud.local/contracts/wire/guided-reposition-frame.schema.json",
  "title": "Guided-reposition lifecycle frame (protocol v0 producer contract)",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "requestId", "sysId", "compId", "status", "ackResult", "observed", "attempts", "horizontalDistanceM", "altitudeErrorM", "reason", "updatedAtMs"],
  "properties": {
    "type": { "const": "guidedReposition" },
    "requestId": { "type": ["string", "null"], "minLength": 1 },
    "sysId": { "type": ["integer", "null"], "minimum": 1, "maximum": 255 },
    "compId": { "type": ["integer", "null"], "minimum": 1, "maximum": 255 },
    "status": { "enum": ["awaitingAck", "awaitingObservation", "complete", "failed"] },
    "ackResult": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
    "observed": { "type": "boolean" },
    "attempts": { "type": "integer", "minimum": 0 },
    "horizontalDistanceM": { "type": ["number", "null"], "minimum": 0 },
    "altitudeErrorM": { "type": ["number", "null"], "minimum": 0 },
    "reason": { "type": ["string", "null"] },
    "updatedAtMs": { "type": "number" },
    "vehicleType": { "type": "integer", "minimum": 0, "maximum": 255 },
    "guidedCustomMode": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "latitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
    "longitudeDeg": { "type": "number", "minimum": -180, "maximum": 180 },
    "relativeAltitudeM": { "type": "number" },
    "arrivalRadiusM": { "type": "number", "exclusiveMinimum": 0 },
    "altitudeToleranceM": { "type": "number", "exclusiveMinimum": 0 },
    "loiterRadiusM": { "type": ["number", "null"] },
    "loiterDirection": { "enum": ["clockwise", "counterclockwise", null] },
    "safetyEnvelope": { "$ref": "#/$defs/safetyEnvelope" },
    "actor": { "type": "string" },
    "requestedAtMs": { "type": "number" },
    "confirmation": { "type": "boolean" },
    "safetyCase": { "const": "isolated-sitl-guided" }
  },
  "$defs": {
    "safetyEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minLatitudeDeg", "maxLatitudeDeg", "minLongitudeDeg", "maxLongitudeDeg", "minRelativeAltitudeM", "maxRelativeAltitudeM", "maxArrivalRadiusM", "maxAltitudeToleranceM"],
      "properties": {
        "minLatitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "maxLatitudeDeg": { "type": "number", "minimum": -90, "maximum": 90 },
        "minLongitudeDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "maxLongitudeDeg": { "type": "number", "minimum": -180, "maximum": 180 },
        "minRelativeAltitudeM": { "type": "number" },
        "maxRelativeAltitudeM": { "type": "number" },
        "maxArrivalRadiusM": { "type": "number", "exclusiveMinimum": 0 },
        "maxAltitudeToleranceM": { "type": "number", "exclusiveMinimum": 0 },
        "maxLoiterRadiusM": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
